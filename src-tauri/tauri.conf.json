{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Murcia",
  "version": "1.0.1",
  "identifier": "com.ceartee.murcia",
  
  "build": {
  
    "frontendDist": "../src"
  },
  
  "app": {
    
    "withGlobalTauri": false,
    
    "windows": [
      {
         "title": "CEARTEE - Murcia",
    "width": 1024,
    "height": 768,
    "minWidth": 1000,
    "minHeight": 600,
    "resizable": true,
    "center": true,
    "maximized": true,
    "devtools": true
      }
    ],
    
    "security": {
      
      "csp": null
    }
  },
  
  "bundle": {
  "active": true,
  "createUpdaterArtifacts": true,
  "targets": ["nsis"],

    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    
    "resources": [],
    "category": "Education",
    "publisher": "CEARTEE",
    "copyright": "© 2024 CEARTEE",
    "homepage": "https://cearteesinaloa.blogspot.mx",
    "shortDescription": "Plataforma educativa CEARTEE",
    "longDescription": "Aplicación educativa para inclusión y aprendizaje interactivo.",
    "licenseFile": "assets/installer/LICENSE.txt",
    
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        
        "silent": true
      },
      
      "nsis": {
       
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "bundles/nsis/header.bmp",
  "sidebarImage": "bundles/nsis/sidebar.bmp"
        
        
      }
    }
  },
  
  "plugins": {
    "updater": {
  "active": false, 
  "dialog": false,
  "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2N0VFMUI1MEUyNTc5NEEKUldSS2VTVU90ZUYrTnZzNC94d0VNUk1tL3NvMlRUL0JTVmhpQWhUa0RxOHhoWGNxN2Q1eFdZVWkK",
  "endpoints": [
  "https://raw.githubusercontent.com/Programix212/Murcia/main/latest.json"
]
,
  "windows": {
    "installMode": "quiet"
  }
}
  }
}